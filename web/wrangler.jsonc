// grade.migueltaibo.com: the files in site/ served by Cloudflare as a Worker's static assets.
// Cloudflare builds it from this folder on every push to main that touches web/.
{
  "$schema": "https://unpkg.com/wrangler@4/config-schema.json",
  "name": "grade",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./site",
    "not_found_handling": "404-page"
  },
  "routes": [{ "pattern": "grade.migueltaibo.com", "custom_domain": true }],
  "workers_dev": false
}
